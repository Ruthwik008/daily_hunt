
class Main {

    public static int countSubsetSum(int[] arr, int sum) {
        int n = arr.length;
        int[][] dp = new int[n + 1][sum + 1];

        dp[0][0] = 1;

        for (int i = 1; i <= n; i++) {
            for (int j = 0; j <= sum; j++) {
                int exclude = dp[i - 1][j];

                int include = 0;
                if (arr[i - 1] <= j) {
                    include = dp[i - 1][j - arr[i - 1]];
                }

                dp[i][j] = include + exclude;
            }
        }

        return dp[n][sum];
    }

    public static int findTargetSumWays(int[] arr, int target) {
        int total = 0;
        for (int num : arr) {
            total += num;
        }

        if (Math.abs(target) > total ||
            (total + target) % 2 != 0) {
            return 0;
        }

        int sum = (total + target) / 2;
        return countSubsetSum(arr, sum);
    }

    public static void main(String[] args) {
        int[] arr = {1, 1, 1, 1, 1};
        int target = 3;

        System.out.println(findTargetSumWays(arr, target));
    }
}
