
public class Main {

    public static int countSubsetSum(int[] arr, int sum) {
        int n = arr.length;
        int[][] dp = new int[n + 1][sum + 1];

        dp[0][0] = 1;

        for (int i = 1; i <= n; i++) {
            for (int j = 0; j <= sum; j++) {
                int exclude = dp[i - 1][j];

                int include = 0;
                if (arr[i - 1] <= j) {
                    include = dp[i - 1][j - arr[i - 1]];
                }

                dp[i][j] = include + exclude;
            }
        }

        return dp[n][sum];
    }

    public static int countPartitions(int[] arr, int diff) {
        int sumOfArray = 0;

        for (int num : arr) {
            sumOfArray += num;
        }

        if (Math.abs(diff) > sumOfArray ||
            (diff + sumOfArray) % 2 != 0) {
            return 0;
        }

        int sum = (diff + sumOfArray) / 2;

        return countSubsetSum(arr, sum);
    }

    public static void main(String[] args) {
        int[] arr = {1, 1, 2, 3};
        int diff = 1;

        System.out.println(countPartitions(arr, diff));
    }
}
